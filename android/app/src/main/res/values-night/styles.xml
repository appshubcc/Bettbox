<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#292C41</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_dark</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- 启动遮罩消失后应用的 NormalTheme，决定 Flutter UI 背后的 Window 背景 -->
    <style name="NormalTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
